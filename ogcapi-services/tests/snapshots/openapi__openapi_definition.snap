          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "type": "https://httpwg.org/specs/rfc7231.html#status.500"
                },
                "schema": {
                  "$ref": "#/components/schemas/Exception"
                }
              }
            },
            "description": "A server error occurred."
          }
        },
        "summary": "Retrieve the list of available tiling schemes (tile matrix sets)",
