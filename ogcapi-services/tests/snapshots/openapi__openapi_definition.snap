---
source: ogcapi-services/tests/openapi.rs
expression: api
---
{
  "components": {
    "schemas": {
      "AccessConstraints": {
        "default": "unclassified",
        "enum": [
          "unclassified",
          "restricted",
          "confidential",
          "secret",
          "topSecret"
        ],
        "type": "string"
      },
      "AdditionalParameter": {
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "items": {},
            "type": "array"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "type": "object"
      },
      "AdditionalParameters": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Metadata"
          },
          {
            "properties": {
              "parameters": {
                "items": {
                  "$ref": "#/components/schemas/AdditionalParameter"
                },
                "type": "array"
              }
            },
            "required": [
              "parameters"
            ],
            "type": "object"
          }
        ]
      },
      "Asset": {
        "additionalProperties": {
          "description": "Additional fields on the asset."
        },
        "description": "An asset is an object that contains a link to data associated\nwith the Item that can be downloaded or streamed. It is allowed\nto add additional fields.",
        "properties": {
          "description": {
            "description": "A description of the Asset providing additional details, such as how it was processed or created.",
            "type": [
              "string",
              "null"
            ]
          },
          "href": {
            "description": "URI to the asset object. Relative and absolute URI are both allowed.",
            "type": "string"
          },
          "roles": {
            "description": "The semantic roles of the asset, similar to the use of rel in links.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "description": "The displayed title for clients and users.",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "Media type of the asset.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "href"
        ],
        "type": "object"
      },
      "Bbox": {
        "description": "Each bounding box is provided as four or six numbers, depending on\nwhether the coordinate reference system includes a vertical axis\n(height or depth):\n\n* Lower left corner, coordinate axis 1\n\n* Lower left corner, coordinate axis 2\n\n* Minimum value, coordinate axis 3 (optional)\n\n* Upper right corner, coordinate axis 1\n\n* Upper right corner, coordinate axis 2\n\n* Maximum value, coordinate axis 3 (optional)\n\nThe coordinate reference system of the values is WGS 84 longitude/latitude\n(<http://www.opengis.net/def/crs/OGC/1.3/CRS84>) unless a different coordinate\nreference system is specified in `crs`.\n\nFor WGS 84 longitude/latitude the values are in most cases the sequence of\nminimum longitude, minimum latitude, maximum longitude and maximum latitude.\nHowever, in cases where the box spans the antimeridian the first value\n(west-most box edge) is larger than the third value (east-most box edge).\n\nIf the vertical axis is included, the third and the sixth number are\nthe bottom and the top of the 3-dimensional bounding box.\n\nIf a feature has multiple spatial geometry properties, it is the decision of the\nserver whether only a single spatial geometry property is used to determine\nthe extent or all relevant geometries.",
        "oneOf": [
          {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          },
          {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          }
        ]
      },
      "BoundingBox": {
        "properties": {
          "bbox": {
            "$ref": "#/components/schemas/Bbox"
          },
          "crs": {
            "type": "string"
          }
        },
        "required": [
          "bbox"
        ],
        "type": "object"
      },
      "BoundingBox2D": {
        "description": "Minimum bounding rectangle surrounding a 2D resource in the CRS indicated elsewere",
        "properties": {
          "crs": {
            "$ref": "#/components/schemas/TilesCrs"
          },
          "lowerLeft": {
            "description": "A 2DPoint in the CRS indicated elsewere",
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "orderedAxes": {
            "description": "Ordered list of names of the dimensions defined in the CRS",
            "items": {
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "upperRight": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          }
        },
        "required": [
          "lowerLeft",
          "upperRight"
        ],
        "type": "object"
      },
      "Category": {
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "description": "URI linking to an external registry which contains the definitive\ndefinition of the observed property",
            "type": "string"
          },
          "label": {
            "$ref": "#/components/schemas/Label"
          }
        },
        "required": [
          "id",
          "label",
          "description"
        ],
        "type": "object"
      },
      "Collection": {
        "additionalProperties": {},
        "description": "A body of resources that belong or are used together. An aggregate, set, or group of related resources.",
        "properties": {
          "assets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Asset"
            },
            "description": "Dictionary of asset objects that can be downloaded, each with a unique key.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "attribution": {
            "description": "Attribution for the collection.",
            "type": [
              "string",
              "null"
            ]
          },
          "crs": {
            "description": "The list of coordinate reference systems supported by the API; the first item is the default coordinate reference system.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "data_queries": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DataQueries",
                "description": "Detailed information relevant to individual query types"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "extent": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Extent"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "itemType": {
            "description": "An indicator about the type of the items in the collection.",
            "type": "string"
          },
          "keywords": {
            "description": "Keywords about the elements in the collection.\n\nDefined by OGC API - Records, STAC, and EDR — but not by OGC API - Features\nPart 1, where servers may use the member name for differently-shaped extensions\n(PDOK, for example, returns an array of objects). Gated so builds without these\nstandards don't fail deserializing such documents; the raw value then lands in\n`additional_properties` instead.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "license": {
            "description": "Collection's license(s), either a SPDX License identifier, `various` if\nmultiple licenses apply or `proprietary` for all other cases.",
            "type": "string"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "output_formats": {
            "description": "List of formats the results can be presented in",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "parameter_names": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ParameterNames"
            },
            "description": "List of the data parameters available in the collection",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "providers": {
            "description": "A list of providers, which may include all organizations capturing or processing the data or the hosting provider.",
            "items": {
              "$ref": "#/components/schemas/Provider"
            },
            "type": "array"
          },
          "stac_extensions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "stac_version": {
            "description": "The STAC version the Collection implements.",
            "type": "string"
          },
          "storageCrs": {
            "type": "string"
          },
          "storageCrsCoordinateEpoch": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "summaries": {
            "additionalProperties": {},
            "description": "A map of property summaries, either a set of values, a range of values or a JSON Schema.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "Must be set to `Collection` to be a valid Collection.",
            "type": "string"
          },
          "updateFrequency": {
            "description": "A time interval of sampling location. The time unit of this property is millisecond.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "license"
        ],
        "type": "object"
      },
      "Collections": {
        "properties": {
          "collections": {
            "items": {
              "$ref": "#/components/schemas/Collection"
            },
            "type": "array"
          },
          "crs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "numberMatched": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "numberReturned": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "timeStamp": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "collections"
        ],
        "type": "object"
      },
      "Conformance": {
        "description": "The Conformance declaration states the conformance classes from standards or community\nspecifications, identified by a URI, that the API conforms to. Clients can but are not\nrequired to use this information. Accessing the Conformance declaration using HTTP GET\nreturns the list of URIs of conformance classes implemented by the server.",
        "properties": {
          "conformsTo": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "conformsTo"
        ],
        "type": "object"
      },
      "Contact": {
        "properties": {
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "description": "Email address of service provider",
            "type": [
              "string",
              "null"
            ]
          },
          "fax": {
            "description": "Fax number of service provider",
            "type": [
              "string",
              "null"
            ]
          },
          "hours": {
            "type": [
              "string",
              "null"
            ]
          },
          "insructions": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "description": "Phone number of service provider",
            "type": [
              "string",
              "null"
            ]
          },
          "postalCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "stateorprovince": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "CornerOfOrigin": {
        "enum": [
          "topLeft",
          "bottomLeft"
        ],
        "type": "string"
      },
      "Crs": {
        "description": "MF-JSON uses a CRS as described in in [GeoJSON:2008](https://geojson.org/geojson-spec#coordinate-reference-system-objects)\nSee [7.2.3 CoordinateReferenceSystem Object](https://docs.ogc.org/is/19-045r3/19-045r3.html#crs)\nSee [6. Overview of Moving features JSON Encodings](https://docs.ogc.org/is/19-045r3/19-045r3.html#_overview_of_moving_features_json_encodings_informative)",
        "oneOf": [
          {
            "description": "A Named CRS object indicates a coordinate reference system by name. In this case, the value of its \"type\" member\nis the string \"Name\". The value of its \"properties\" member is a JSON object containing a \"name\" member whose\nvalue is a string identifying a coordinate reference system (not JSON null value). The value of \"href\" and \"type\"\nis a JSON null value. This standard recommends an EPSG[3] code as the value of \"name\", such as `EPSG::4326`.\n\nSee [7.2.3.1 Named CRS](https://docs.ogc.org/is/19-045r3/19-045r3.html#_7_2_3_1_named_crs)",
            "properties": {
              "properties": {
                "description": "A Named CRS object indicates a coordinate reference system by name. In this case, the value of its \"type\" member\nis the string \"Name\". The value of its \"properties\" member is a JSON object containing a \"name\" member whose\nvalue is a string identifying a coordinate reference system (not JSON null value). The value of \"href\" and \"type\"\nis a JSON null value. This standard recommends an EPSG[3] code as the value of \"name\", such as `EPSG::4326`.\n\nSee [7.2.3.1 Named CRS](https://docs.ogc.org/is/19-045r3/19-045r3.html#_7_2_3_1_named_crs)",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              },
              "type": {
                "enum": [
                  "Name"
                ],
                "type": "string"
              }
            },
            "required": [
              "properties",
              "type"
            ],
            "type": "object"
          },
          {
            "description": "A linked CRS object has one required member \"href\" and one optional member \"type\". The value of the required \"href\"\nmember is a dereferenceable URI. The value of the optional \"type\" member is a string that hints at the format used\nto represent CRS parameters at the provided URI. Suggested values are: \"Proj4\", \"OGCWKT\", \"ESRIWKT\", but others can\nbe used.\n\nSee [7.2.3.2. Linked CRS](https://docs.ogc.org/is/19-045r3/19-045r3.html#_7_2_3_2_linked_crs)",
            "properties": {
              "properties": {
                "description": "A linked CRS object has one required member \"href\" and one optional member \"type\". The value of the required \"href\"\nmember is a dereferenceable URI. The value of the optional \"type\" member is a string that hints at the format used\nto represent CRS parameters at the provided URI. Suggested values are: \"Proj4\", \"OGCWKT\", \"ESRIWKT\", but others can\nbe used.\n\nSee [7.2.3.2. Linked CRS](https://docs.ogc.org/is/19-045r3/19-045r3.html#_7_2_3_2_linked_crs)",
                "properties": {
                  "href": {
                    "type": "string"
                  },
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "href"
                ],
                "type": "object"
              },
              "type": {
                "enum": [
                  "Link"
                ],
                "type": "string"
              }
            },
            "required": [
              "properties",
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "CrsObject": {
        "properties": {
          "crs": {
            "description": "name of the coordinate reference system, used as the value in the crs\nquery parameter to define the required output CRS",
            "type": "string"
          },
          "wkt": {
            "description": "Well Known text description of the coordinate reference system",
            "type": "string"
          }
        },
        "required": [
          "crs",
          "wkt"
        ],
        "type": "object"
      },
      "DataQueries": {
        "description": "Detailed information relevant to individual query types",
        "properties": {
          "position": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PositionLink"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "DataType": {
        "enum": [
          "integer",
          "float",
          "string"
        ],
        "type": "string"
      },
      "DescriptionType": {
        "description": "Basic description type",
        "properties": {
          "additionalParameters": {
            "$ref": "#/components/schemas/AdditionalParameters"
          },
          "description": {
            "type": "string"
          },
          "keywords": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "metadata": {
            "items": {
              "$ref": "#/components/schemas/Metadata"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Exception": {
        "additionalProperties": {},
        "description": "Exception based on [`RFC 7807`](https://datatracker.ietf.org/doc/html/rfc7807)",
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "type": "string"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.\nIt may or may not yield further information if dereferenced.",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code generated by the origin server for this occurrence\nof the problem.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type.",
            "type": "string"
          },
          "type": {
            "description": "A URI reference that identifies the problem type.",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "Execute": {
        "additionalProperties": false,
        "description": "Process execution",
        "properties": {
          "inputs": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Input"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "outputs": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Output"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "response": {
            "$ref": "#/components/schemas/Response"
          },
          "subscriber": {
            "$ref": "#/components/schemas/Subscriber"
          }
        },
        "type": "object"
      },
      "Extent": {
        "description": "The extent of the features in the collection. In the Core only spatial and\ntemporal extents are specified. Extensions may add additional members to\nrepresent other extents, for example, thermal or pressure ranges.",
        "properties": {
          "spatial": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SpatialExtent"
              },
              {
                "type": "null"
              }
            ]
          },
          "temporal": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TemporalExtent"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "Feature": {
        "description": "Abstraction of real world phenomena (ISO 19101-1:2014)",
        "properties": {
          "assets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Asset"
            },
            "description": "Dictionary of asset objects that can be downloaded, each with a unique key.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "bbox": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Bbox",
                "description": "Bounding Box of the asset represented by this Item, formatted according to RFC 7946, section 5."
              },
              {
                "type": "null"
              }
            ]
          },
          "collection": {
            "type": [
              "string",
              "null"
            ]
          },
          "conformsTo": {
            "description": "Declared JSON-FG conformance classes. Set only on the top-level object.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "coordRefSys": {
            "description": "Coordinate reference system of `place` (JSON-FG).",
            "type": "object"
          },
          "crs": {
            "$ref": "#/components/schemas/Crs"
          },
          "featureSchema": {
            "description": "Link to the schema of the feature's `properties` (JSON-FG).",
            "type": "object"
          },
          "featureType": {
            "description": "JSON-FG feature classifier(s).",
            "type": "object"
          },
          "geometry": {
            "oneOf": [
              {
                "properties": {
                  "bbox": {
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "type": "array"
                  },
                  "coordinates": {
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "type": "array"
                  },
                  "type": {
                    "enum": [
                      "Point"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ],
                "title": "GeoJSON Point",
                "type": "object"
              },
              {
                "properties": {
                  "bbox": {
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "type": "array"
                  },
                  "coordinates": {
                    "items": {
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "type": "array"
                    },
                    "minItems": 2,
                    "type": "array"
                  },
                  "type": {
                    "enum": [
                      "LineString"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ],
                "title": "GeoJSON LineString",
                "type": "object"
              },
              {
                "properties": {
                  "bbox": {
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "type": "array"
                  },
                  "coordinates": {
                    "items": {
                      "items": {
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "type": "array"
                      },
                      "minItems": 4,
                      "type": "array"
                    },
                    "type": "array"
                  },
                  "type": {
                    "enum": [
                      "Polygon"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ],
                "title": "GeoJSON Polygon",
                "type": "object"
              },
              {
                "properties": {
                  "bbox": {
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "type": "array"
                  },
                  "coordinates": {
                    "items": {
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "type": "array"
                    },
                    "type": "array"
                  },
                  "type": {
                    "enum": [
                      "MultiPoint"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ],
                "title": "GeoJSON MultiPoint",
                "type": "object"
              },
              {
                "properties": {
                  "bbox": {
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "type": "array"
                  },
                  "coordinates": {
                    "items": {
                      "items": {
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "type": "array"
                      },
                      "minItems": 2,
                      "type": "array"
                    },
                    "type": "array"
