            "oneOf": [
              {
                "$ref": "#/components/schemas/MeasurementType"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedProperty": {
            "$ref": "#/components/schemas/ObservedPropertyCollection"
          },
          "type": {
            "enum": [
              "Parameter"
            ],
            "type": "string"
          },
          "unit": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Units"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "observedProperty"
        ],
        "type": "object"
      },
      "ParametricValues": {
        "description": "A [`ParametricValues`] object is a JSON object that represents a collection of parametric values of dynamic non-spatial\nattributes that are ascertained at the same times. A parametric value may be a time-varying measure, a sequence of\ntexts, or a sequence of images. Even though the parametric value may depend on the spatiotemporal location,\nMF-JSON Prism only considers the temporal dependencies of their changes of value.\n\nSee [7.2.2.1 MF-JSON ParametricValues](https://docs.ogc.org/is/19-045r3/19-045r3.html#pvalues)",
        "oneOf": [
          {
            "description": "The \"values\" member contains any numeric values.",
            "properties": {
              "description": {
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "form": {
                "description": "The \"form\" member is optional and its value is a JSON string as a common code (3 characters) described in\nthe [Code List Rec 20 by the UN Centre for Trade Facilitation and Electronic Business (UN/CEFACT)](https://www.unece.org/uncefact/codelistrecs.html) or a\nURL specifying the unit of measurement. This member is applied only for a temporal property whose value\ntype is Measure.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "interpolation": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Interpolation",
                    "description": "Allowed Interpolations: Discrete, Step, Linear, Regression"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "enum": [
                  "Measure"
                ],
                "type": "string"
              },
              "values": {
                "items": {
                  "format": "double",
                  "type": "number"
                },
                "type": "array"
              }
            },
            "required": [
              "values",
              "type"
            ],
            "type": "object"
          },
          {
            "description": "The \"values\" member contains any strings.",
            "properties": {
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interpolation": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Interpolation",
                    "description": "Allowed Interpolations: Discrete, Step"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "enum": [
                  "Text"
                ],
                "type": "string"
              },
              "values": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "values",
              "type"
            ],
            "type": "object"
          },
          {
            "description": "The \"values\" member contains Base64 strings converted from images or URLs to address images.",
            "properties": {
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interpolation": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Interpolation",
                    "description": "Allowed Interpolations: Discrete, Step"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "enum": [
                  "Image"
                ],
                "type": "string"
              },
              "values": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "values",
              "type"
            ],
            "type": "object"
          }
        ]
      },
