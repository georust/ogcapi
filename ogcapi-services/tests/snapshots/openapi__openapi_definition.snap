                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ],
                "title": "GeoJSON MultiPoint",
                "type": "object"
              },
              {
                "properties": {
                  "bbox": {
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
