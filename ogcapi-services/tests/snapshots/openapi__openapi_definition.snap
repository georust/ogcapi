            ],
            "type": "object"
          }
        ]
      },
      "TemporalComplexGeometry": {
        "description": "A [`TemporalComplexGeometry`] object represents a set of [`TemporalPrimitiveGeometry`] objects. When a [`TemporalGeometry`]\nobject has a \"type\" member is `MovingGeometryCollection`, the object is specialized as a [`TemporalComplexGeometry`]\nobject with one additional mandatory member named \"prisms\". The value of the \"prisms\" member is represented by a\nJSON array of a set of [`TemporalPrimitiveGeometry`] instances having at least one element in the array.\n\nSee [7.2.1.2. TemporalComplexGeometry Object](https://docs.ogc.org/is/19-045r3/19-045r3.html#tcomplex)",
        "properties": {
          "crs": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Crs"
              },
              {
                "type": "null"
              }
            ]
          },
          "prisms": {
            "items": {
              "$ref": "#/components/schemas/TemporalPrimitiveGeometry"
            },
            "type": "array"
          },
          "trs": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Trs"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "$ref": "#/components/schemas/Type"
          }
        },
        "required": [
          "type",
          "prisms"
        ],
        "type": "object"
      },
      "TemporalExtent": {
        "description": "The temporal extent of the features in the collection.",
        "properties": {
          "interval": {
            "description": "One or more time intervals that describe the temporal extent of the\ndataset. The value `null` is supported and indicates an unbounded\ninterval end. In the Core only a single time interval is supported.\nExtensions may support multiple intervals. If multiple intervals are\nprovided, the union of the intervals describes the temporal extent.",
            "items": {
              "items": {
                "format": "date-time",
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": "array"
            },
            "type": "array"
          },
          "trs": {
            "description": "Coordinate reference system of the coordinates in the temporal extent\n(property `interval`). The default reference system is the Gregorian\ncalendar. In the Core this is the only supported temporal coordinate\nreference system. Extensions may support additional temporal coordinate\nreference systems and add additional enum values.",
            "type": "string"
          }
        },
        "required": [
          "interval"
        ],
        "type": "object"
      },
      "TemporalGeometry": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TemporalPrimitiveGeometry"
          },
          {
            "$ref": "#/components/schemas/TemporalComplexGeometry"
          }
        ]
      },
      "TemporalPrimitiveGeometry": {
        "allOf": [
          {},
          {
            "properties": {
              "crs": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Crs"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interpolation": {
                "$ref": "#/components/schemas/Interpolation"
              },
              "trs": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Trs"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "type": "object"
          }
        ],
        "description": "[`TemporalPrimitiveGeometry`] Object\n\nA [`TemporalPrimitiveGeometry`](https://docs.ogc.org/is/19-045r3/19-045r3.html#tprimitive) object describes the\nmovement of a geographic feature whose leaf geometry at a time instant is drawn by a primitive geometry such as a\npoint, linestring, and polygon in the two- or three-dimensional spatial coordinate system, or a point cloud in the\nthree-dimensional spatial coordinate system."
      },
      "TemporalPrimitiveValue_String": {
        "description": "The [`TemporalPrimitiveValue`] resource represents the dynamic change of a non-spatial attribute’s value with time. An\nabbreviated copy of this information is returned for each [`TemporalPrimitiveValue`] in the\n{root}/collections/{collectionId}/items/{mFeatureId}/tproperties/{tPropertyName} response.\n\nSee [8.10. TemporalPrimitiveValue](https://docs.ogc.org/is/22-003r3/22-003r3.html#resource-temporalPrimitiveValue-section)",
        "properties": {
          "datetimes": {
            "description": "A sequence of monotonic increasing instants.",
            "items": {
              "format": "date-time",
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "A unique identifier to the temporal primitive value.",
            "type": [
              "string",
              "null"
            ]
          },
          "interpolation": {
            "$ref": "#/components/schemas/Interpolation",
            "description": "A predefined type for a dynamic value (i.e., one of ‘Discrete’, ‘Step’, ‘Linear’, or ‘Regression’)."
          },
          "values": {
            "description": "A sequence of dynamic values having the same number of elements as “datetimes”.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "datetimes",
          "values",
          "interpolation"
        ],
        "type": "object"
      },
      "TemporalPrimitiveValue_bool": {
        "description": "The [`TemporalPrimitiveValue`] resource represents the dynamic change of a non-spatial attribute’s value with time. An\nabbreviated copy of this information is returned for each [`TemporalPrimitiveValue`] in the\n{root}/collections/{collectionId}/items/{mFeatureId}/tproperties/{tPropertyName} response.\n\nSee [8.10. TemporalPrimitiveValue](https://docs.ogc.org/is/22-003r3/22-003r3.html#resource-temporalPrimitiveValue-section)",
        "properties": {
          "datetimes": {
            "description": "A sequence of monotonic increasing instants.",
            "items": {
              "format": "date-time",
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "A unique identifier to the temporal primitive value.",
            "type": [
              "string",
              "null"
            ]
          },
          "interpolation": {
            "$ref": "#/components/schemas/Interpolation",
            "description": "A predefined type for a dynamic value (i.e., one of ‘Discrete’, ‘Step’, ‘Linear’, or ‘Regression’)."
          },
          "values": {
            "description": "A sequence of dynamic values having the same number of elements as “datetimes”.",
            "items": {
              "type": "boolean"
            },
            "type": "array"
          }
        },
        "required": [
          "datetimes",
          "values",
          "interpolation"
        ],
        "type": "object"
      },
      "TemporalPrimitiveValue_f64": {
        "description": "The [`TemporalPrimitiveValue`] resource represents the dynamic change of a non-spatial attribute’s value with time. An\nabbreviated copy of this information is returned for each [`TemporalPrimitiveValue`] in the\n{root}/collections/{collectionId}/items/{mFeatureId}/tproperties/{tPropertyName} response.\n\nSee [8.10. TemporalPrimitiveValue](https://docs.ogc.org/is/22-003r3/22-003r3.html#resource-temporalPrimitiveValue-section)",
        "properties": {
          "datetimes": {
            "description": "A sequence of monotonic increasing instants.",
            "items": {
              "format": "date-time",
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "A unique identifier to the temporal primitive value.",
            "type": [
              "string",
              "null"
            ]
          },
          "interpolation": {
            "$ref": "#/components/schemas/Interpolation",
            "description": "A predefined type for a dynamic value (i.e., one of ‘Discrete’, ‘Step’, ‘Linear’, or ‘Regression’)."
          },
          "values": {
            "description": "A sequence of dynamic values having the same number of elements as “datetimes”.",
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          }
        },
        "required": [
          "datetimes",
          "values",
          "interpolation"
        ],
        "type": "object"
      },
      "TemporalPrimitiveValue_i64": {
        "description": "The [`TemporalPrimitiveValue`] resource represents the dynamic change of a non-spatial attribute’s value with time. An\nabbreviated copy of this information is returned for each [`TemporalPrimitiveValue`] in the\n{root}/collections/{collectionId}/items/{mFeatureId}/tproperties/{tPropertyName} response.\n\nSee [8.10. TemporalPrimitiveValue](https://docs.ogc.org/is/22-003r3/22-003r3.html#resource-temporalPrimitiveValue-section)",
        "properties": {
          "datetimes": {
            "description": "A sequence of monotonic increasing instants.",
            "items": {
              "format": "date-time",
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "A unique identifier to the temporal primitive value.",
            "type": [
              "string",
              "null"
            ]
          },
          "interpolation": {
            "$ref": "#/components/schemas/Interpolation",
            "description": "A predefined type for a dynamic value (i.e., one of ‘Discrete’, ‘Step’, ‘Linear’, or ‘Regression’)."
          },
          "values": {
            "description": "A sequence of dynamic values having the same number of elements as “datetimes”.",
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "datetimes",
          "values",
          "interpolation"
        ],
        "type": "object"
      },
      "TemporalProperties": {
        "description": "A [`TemporalProperties`] object consists of the set of [`TemporalProperty`] or a set of [`MFJsonTemporalProperties`].\n\nSee [8.8 TemporalProperties](https://docs.ogc.org/is/22-003r3/22-003r3.html#resource-temporalProperties-section)",
        "properties": {
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "numberMatched": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "numberReturned": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "temporalProperties": {
            "$ref": "#/components/schemas/TemporalPropertiesValue"
          },
          "timeStamp": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "temporalProperties"
        ],
        "type": "object"
      },
      "TemporalPropertiesValue": {
        "oneOf": [
          {
            "description": "[`MFJsonTemporalProperties`] allows to represent multiple property values all measured at the same points in time.",
            "items": {
              "$ref": "#/components/schemas/MFJsonTemporalProperties"
            },
            "type": "array"
          },
          {
            "description": "[`TemporalProperty`] allows to represent a property value at independent points in time.",
            "items": {
              "$ref": "#/components/schemas/TemporalProperty"
            },
            "type": "array"
          }
        ]
      },
      "TemporalProperty": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TemporalPropertyValue"
          },
          {
            "properties": {
              "description": {
                "description": "A short description",
                "type": [
                  "string",
                  "null"
                ]
              },
              "form": {
                "description": "A unit of measure",
                "type": [
                  "string",
                  "null"
                ]
              },
              "links": {
                "items": {
                  "$ref": "#/components/schemas/Link"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "name": {
                "description": "An identifier for the resource assigned by an external entity.",
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          }
        ],
        "description": "A temporal property object is a collection of dynamic non-spatial attributes and their temporal values with time.\nAn abbreviated copy of this information is returned for each [`TemporalProperty`] in the\n[{root}/collections/{collectionId}/items/{mFeatureId}/tproperties](super::temporal_properties::TemporalProperties) response.\nThe schema for the temporal property object presented in this clause is an extension of the [ParametricValues Object](https://docs.opengeospatial.org/is/19-045r3/19-045r3.html#tproperties) defined in [MF-JSON](https://docs.ogc.org/is/22-003r3/22-003r3.html#OGC_19-045r3).\n\nSee [8.9. TemporalProperty](https://docs.ogc.org/is/22-003r3/22-003r3.html#resource-temporalProperty-section)"
      },
      "TemporalPropertyValue": {
        "description": "A predefined temporal property type.\n",
        "oneOf": [
          {
            "properties": {
              "type": {
                "enum": [
                  "TBoolean"
                ],
                "type": "string"
              },
              "valueSequence": {
                "items": {
                  "$ref": "#/components/schemas/TemporalPrimitiveValue_bool"
                },
                "type": "array"
              }
            },
            "required": [
              "valueSequence",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "TText"
                ],
                "type": "string"
              },
              "valueSequence": {
                "items": {
                  "$ref": "#/components/schemas/TemporalPrimitiveValue_String"
                },
                "type": "array"
              }
            },
            "required": [
              "valueSequence",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "TInteger"
                ],
                "type": "string"
              },
              "valueSequence": {
                "items": {
                  "$ref": "#/components/schemas/TemporalPrimitiveValue_i64"
                },
                "type": "array"
              }
            },
            "required": [
              "valueSequence",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "TReal"
                ],
                "type": "string"
              },
              "valueSequence": {
                "items": {
                  "$ref": "#/components/schemas/TemporalPrimitiveValue_f64"
                },
                "type": "array"
              }
            },
            "required": [
              "valueSequence",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "TImage"
                ],
                "type": "string"
              },
              "valueSequence": {
                "items": {
                  "$ref": "#/components/schemas/TemporalPrimitiveValue_String"
                },
                "type": "array"
              }
            },
            "required": [
              "valueSequence",
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "TileMatrix": {
        "description": "A tile matrix, usually corresponding to a particular zoom level of a\n[`TileMatrixSet`].",
        "properties": {
          "cellSize": {
            "description": "Cell size of this tile matrix",
            "format": "double",
            "type": "number"
          },
          "cornerOfOrigin": {
            "$ref": "#/components/schemas/CornerOfOrigin",
            "description": "The corner of the tile matrix (_topLeft_ or\n_bottomLeft_) used as the origin for numbering tile rows and columns.\nThis corner is also a corner of the (0, 0) tile."
          },
          "description": {
            "description": "Brief narrative description of a tile matrix, normally available\nfor display to a human",
            "type": "string"
          },
          "id": {
            "description": "Identifier selecting one of the scales defined in the [`TileMatrixSet`]\nand representing the scaleDenominator the tile.",
            "type": "string"
          },
          "keywords": {
            "description": "Unordered list of one or more commonly used or formalized word(s) or\nphrase(s) used to describe this tile set",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "matrixHeight": {
            "description": "Height of the matrix (number of tiles in height)",
            "minimum": 1,
            "type": "integer"
          },
          "matrixWidth": {
            "description": "Width of the matrix (number of tiles in width)",
            "minimum": 1,
            "type": "integer"
          },
          "pointOfOrigin": {
            "description": "Precise position in CRS coordinates of the corner of origin (e.g. the\ntop-left corner) for this tile matrix. This position is also a corner\nof the (0, 0) tile.",
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "scaleDenominator": {
            "description": "Scale denominator of this tile matrix",
            "format": "double",
            "type": "number"
          },
          "tileHeight": {
            "description": "Height of each tile of this tile matrix in pixels",
            "minimum": 1,
            "type": "integer"
          },
          "tileWidth": {
            "description": "Width of each tile of this tile matrix in pixels",
            "minimum": 1,
            "type": "integer"
          },
          "title": {
            "description": "Title of a tile matrix, normally used for display to a human",
            "type": "string"
          },
          "variableMatrixWidths": {
            "description": "Describes the rows that has variable matrix width",
            "items": {
              "$ref": "#/components/schemas/VariableMatrixWidth"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "scaleDenominator",
          "cellSize",
          "pointOfOrigin",
          "tileWidth",
          "tileHeight",
          "matrixWidth",
          "matrixHeight"
        ],
        "type": "object"
      },
      "TileMatrixLimits": {
        "description": "A resource describing useful to create an array that describes the limits\nfor a tile set [`super::TileMatrixSet`] based on the OGC Two Dimensional Tile Matrix Set and Tile Set Metadata Standard",
        "properties": {
          "maxTileCol": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "maxTileRow": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "minTileCol": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "minTileRow": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "tileMatrix": {
            "type": "string"
          }
        },
        "required": [
          "tileMatrix",
          "minTileRow",
          "maxTileRow",
          "minTileCol",
          "maxTileCol"
        ],
        "type": "object"
      },
      "TileMatrixSet": {
        "description": "A definition of a tile matrix set following the Tile Matrix Set standard.\nFor tileset metadata, such a description (in `tileMatrixSet` property) is\nonly required for offline use, as an alternative to a link with a\n`http://www.opengis.net/def/rel/ogc/1.0/tiling-scheme` relation type.",
        "properties": {
          "boundingBox": {
            "$ref": "#/components/schemas/BoundingBox2D",
            "description": "Minimum bounding rectangle surrounding the tile matrix set, in the\nsupported CRS"
          },
          "crs": {
            "$ref": "#/components/schemas/TilesCrs",
            "description": "Coordinate Reference System (CRS)"
          },
          "description": {
            "description": "Brief narrative description of a tile matrix set, normally available\nfor display to a human",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/TileMatrixSetId",
            "description": "Tile matrix set identifier"
          },
          "keywords": {
            "description": "Unordered list of one or more commonly used or formalized word(s) or\nphrase(s) used to describe this resource entity",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "orderedAxes": {
            "description": "Ordered list of names of the dimensions defined in the CRS",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "tileMatrices": {
            "description": "Describes scale levels and its tile matrices",
            "items": {
              "$ref": "#/components/schemas/TileMatrix"
            },
            "type": "array"
          },
          "title": {
            "description": "Title of a tile matrix set, normally used for display to a human",
            "type": "string"
          },
          "uri": {
            "description": "Reference to an official source for this tile matrix set",
            "type": "string"
          },
          "wellKnownScaleSet": {
            "description": "Reference to a well-known scale set",
            "type": "string"
          }
        },
        "required": [
          "id",
          "crs",
          "tileMatrices"
        ],
        "type": "object"
      },
      "TileMatrixSetId": {
        "description": "Identifier for a supported [`TileMatrixSet`]",
        "oneOf": [
          {
            "enum": [
              "WebMercatorQuad"
            ],
            "type": "string"
          },
          {
            "properties": {
              "Custom": {
                "type": "string"
              }
            },
            "required": [
              "Custom"
            ],
            "type": "object"
          }
        ]
      },
      "TileMatrixSetItem": {
        "description": "A minimal tile matrix set element for use within a list of tile matrix\nsets linking to a full definition.",
        "properties": {
          "crs": {
            "$ref": "#/components/schemas/TilesCrs"
          },
          "id": {
            "$ref": "#/components/schemas/TileMatrixSetId",
            "description": "Optional local tile matrix set identifier, e.g. for use as unspecified\n`{tileMatrixSetId}` parameter. Implementation of 'identifier'"
          },
          "links": {
            "description": "Links to related resources. A 'self' link to the tile matrix set\ndefinition is required.",
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "title": {
            "description": "Title of this tile matrix set, normally used for display to a human",
            "type": "string"
          },
          "uri": {
            "description": "Reference to an official source for this tileMatrixSet",
            "type": "string"
          }
        },
        "required": [
          "links"
        ],
        "type": "object"
      },
      "TileMatrixSets": {
        "description": "A definition of a tile matrix set following the Tile Matrix Set standard.\nFor tileset metadata, such a description (in `tileMatrixSet` property) is\nonly required for offline use, as an alternative to a link with a\n`http://www.opengis.net/def/rel/ogc/1.0/tiling-scheme` relation type.",
        "properties": {
          "tileMatrixSets": {
            "items": {
              "$ref": "#/components/schemas/TileMatrixSetItem"
            },
            "type": "array"
          }
        },
        "required": [
          "tileMatrixSets"
        ],
        "type": "object"
      },
      "TilePoint": {
        "properties": {
          "cellSize": {
            "description": "Cell size of the tile matrix selected",
            "format": "double",
            "type": "number"
          },
          "coordinates": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "crs": {
            "$ref": "#/components/schemas/TilesCrs"
          },
          "scaleDenominator": {
            "description": "Scale denominator of the tile matrix selected",
            "format": "double",
            "type": "number"
          },
          "tileMatrix": {
            "description": "[`TileMatrix`] identifier associated with the scaleDenominator",
            "type": "string"
          }
        },
        "required": [
          "coordinates"
        ],
        "type": "object"
      },
      "TileSet": {
        "description": "A resource describing a tileset based on the OGC Two Dimensional Tile Matrix Set and Tile Set Metadata.\nAt least one of the [`TileMatrixSet`], or a link with 'rel' tiling-scheme\"",
        "properties": {
          "accessConstraints": {
            "$ref": "#/components/schemas/AccessConstraints",
            "description": "Restrictions on the availability of the Tile Set that the user needs to\nbe aware of before using or redistributing the Tile Set"
          },
          "attribution": {
            "description": "Short reference to recognize the author or provider",
            "type": "string"
          },
          "boundingBox": {
            "$ref": "#/components/schemas/BoundingBox2D",
            "description": "Minimum bounding rectangle surrounding the tile matrix set, in the supported CRS"
          },
          "centerPoint": {
            "$ref": "#/components/schemas/TilePoint",
            "description": "Location of a tile that nicely represents the tileset. Implementations\nmay use this center value to set the default location or to present a\nrepresentative tile in a user interface"
          },
          "created": {
            "description": "When the Tile Set was first produced",
            "format": "date-time",
            "type": "string"
          },
          "crs": {
            "$ref": "#/components/schemas/TilesCrs",
            "description": "Coordinate Reference System (CRS)"
          },
          "dataType": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "enum": [
                      "map"
                    ],
                    "type": "string"
                  },
                  {
                    "enum": [
                      "vector"
                    ],
                    "type": "string"
                  },
                  {
                    "enum": [
                      "coverage"
                    ],
                    "type": "string"
                  },
                  {
                    "properties": {
                      "string": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "string"
                    ],
                    "type": "object"
                  }
                ]
              },
              {
                "description": "Type of data represented in the tileset",
                "type": "object"
              }
            ]
          },
          "description": {
            "description": "Brief narrative description of this tile set",
            "type": "string"
          },
          "epoch": {
            "description": "Epoch of the Coordinate Reference System (CRS)",
            "format": "double",
            "type": "number"
          },
          "keywords": {
            "description": "Unordered list of one or more commonly used or formalized word(s) or\nphrase(s) used to describe a [`TileSet`]",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "layers": {
            "items": {
              "$ref": "#/components/schemas/GeospatialData"
            },
            "minItems": 1,
            "type": "array"
          },
          "license": {
            "description": "License applicable to the tiles",
            "type": "string"
          },
          "links": {
            "description": "Links to related resources. Possible link 'rel' values are: 'dataset'\nfor a URL pointing to the dataset, 'tiles' for a URL template to get\nthe tiles; 'alternate' for a URL pointing to another representation of\nthe [`TileSetMetadata`] (e.g a [`TileJSON` file); 'tiling-scheme' for a\ndefinition of the [`TileMatrixSet`]",
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "mediaTypes": {
            "description": "Media types available for the tiles",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pointOfContact": {
            "description": "Useful information to contact the authors or custodians for the Tile Set",
            "type": "string"
          },
          "style": {
            "$ref": "#/components/schemas/Style",
            "description": "Style involving all layers used to generate the tileset"
          },
          "tileMatrixSetLimits": {
            "description": "Limits for the [`TileRow`] and [`TileCol`] values for each [`TileMatrix`] in the\n[`TileMatrixSet`]. If missing, there are no limits other that the ones\nimposed by the [`TileMatrixSet`]. If present the tile matrices listed are\nlimited and the rest not available at all",
            "items": {
              "$ref": "#/components/schemas/TileMatrixLimits"
            },
            "type": "array"
          },
          "tileMatrixSetURI": {
            "description": "Reference to a Tile Matrix Set on the OGC NA definition server\n(<http://www.opengis.net/def/tms/>). Required if the tile matrix set is\nregistered on the definition server.",
            "format": "uri",
            "type": "string"
          },
          "title": {
            "description": "A title for this tileset",
            "type": "string"
          },
          "updated": {
            "description": "Last Tile Set change/revision",
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "description": "Version of the Tile Set. Changes if the data behind the tiles has been changed",
            "type": "string"
          }
        },
        "required": [
          "dataType",
          "crs",
          "links"
        ],
        "type": "object"
      },
      "TileSetItem": {
        "description": "A minimal tileset element for use within a list of tilesets linking to\nfull description of those tilesets.",
        "properties": {
          "crs": {
            "$ref": "#/components/schemas/TilesCrs",
            "description": "Coordinate Reference System (CRS)"
          },
          "dataType": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "enum": [
                      "map"
                    ],
                    "type": "string"
                  },
                  {
                    "enum": [
                      "vector"
                    ],
                    "type": "string"
                  },
                  {
                    "enum": [
                      "coverage"
                    ],
                    "type": "string"
                  },
                  {
                    "properties": {
                      "string": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "string"
                    ],
                    "type": "object"
                  }
                ]
              },
              {
                "description": "Type of data represented in the tileset",
                "type": "object"
              }
            ]
          },
          "links": {
            "description": "Links to related resources. A 'self' link to the tileset as well as a\n<http://www.opengis.net/def/rel/ogc/1.0/tiling-scheme> link to a\ndefinition of the [`TileMatrixSet`] are required.",
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "tileMatrixSetURI": {
            "description": "Reference to a Tile Matrix Set on an offical source for Tile Matrix Sets\nsuch as the OGC NA definition server (<http://www.opengis.net/def/tms/>).\nRequired if the tile matrix set is registered on an open official source.",
            "format": "uri",
            "type": "string"
          },
          "title": {
            "description": "A title for this tileset",
            "type": "string"
          }
        },
        "required": [
          "dataType",
          "crs",
          "links"
        ],
        "type": "object"
      },
      "TileSets": {
        "properties": {
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "tilesets": {
            "items": {
              "$ref": "#/components/schemas/TileSetItem"
            },
            "type": "array"
          }
        },
        "required": [
          "tilesets"
        ],
        "type": "object"
      },
      "TilesCrs": {
        "description": "Coordinate Reference System (CRS)",
        "oneOf": [
          {
            "description": "Simplification of the object into a url if the other properties are not present",
            "type": "string"
          },
          {
            "description": "Reference to one coordinate reference system (CRS)",
            "properties": {
              "uri": {
                "type": "string"
              }
            },
            "required": [
              "uri"
            ],
            "type": "object"
          },
          {
            "description": "An object defining the CRS using the JSON encoding for Well-known text\nrepresentation of coordinate reference systems 2.0",
            "properties": {
              "wkt": {
                "additionalProperties": {},
                "propertyNames": {
                  "type": "string"
                },
                "type": "object"
              }
            },
            "required": [
              "wkt"
            ],
            "type": "object"
          },
          {
            "description": "A reference system data structure as defined in the `MD_ReferenceSystem` of the ISO 19115",
            "properties": {
              "referenceSystem": {
                "type": "string"
              }
            },
            "required": [
              "referenceSystem"
            ],
            "type": "object"
          }
        ]
      },
      "TransmissionMode": {
        "default": "value",
        "enum": [
          "value",
          "reference"
        ],
        "type": "string"
      },
      "Trs": {
        "oneOf": [
          {
            "properties": {
              "properties": {
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              },
              "type": {
                "enum": [
                  "Name"
                ],
                "type": "string"
              }
            },
            "required": [
              "properties",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "properties": {
                "properties": {
                  "href": {
                    "type": "string"
                  },
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "href"
                ],
                "type": "object"
              },
              "type": {
                "enum": [
                  "Link"
                ],
                "type": "string"
              }
            },
            "required": [
              "properties",
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "Type": {
        "enum": [
          "MovingGeometryCollection"
        ],
        "type": "string"
      },
      "Units": {
        "description": "Definition of data units",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Label"
              },
              {
                "type": "null"
              }
            ]
          },
          "symbol": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Symbol",
                "description": "Describe unit symbol"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "VariableMatrixWidth": {
        "description": "Variable Matrix Width data structure",
        "properties": {
          "coalesce": {
            "description": "Number of tiles in width that coalesce in a single tile for these rows",
            "minimum": 2,
            "type": "integer"
          },
          "maxTileRow": {
            "description": "Last tile row where the coalescence factor applies for this tilematrix",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "minTileRow": {
            "description": "First tile row where the coalescence factor applies for this tilematrix",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "coalesce",
          "minTileRow",
          "maxTileRow"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "GeoRust `ogcapi` project on GitHub",
      "url": "https://github.com/georust/ogcapi"
    },
    "description": "Server implementation of several OGC API Standards.",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "ogcapi-services",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "The landing page provides links to the API definition and the\nconformance statements for this API.",
        "operationId": "root",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandingPage"
                }
              }
            },
            "description": "The landing page provides links to the API definition (link relations `service-desc` and `service-doc`), and the Conformance declaration (path `/conformance`, link relation `conformance`)."
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "status": 400,
                  "type": "https://httpwg.org/specs/rfc7231.html#status.400"
                },
                "schema": {
                  "$ref": "#/components/schemas/Exception"
                }
              }
            },
            "description": "General HTTP error response."
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "type": "https://httpwg.org/specs/rfc7231.html#status.500"
                },
                "schema": {
                  "$ref": "#/components/schemas/Exception"
                }
              }
            },
            "description": "A server error occurred."
          }
        },
        "summary": "Landing page",
        "tags": [
          "Capabilities"
        ]
      }
    },
    "/api": {
      "get": {
        "operationId": "api",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {},
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "The Open API definition."
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "type": "https://httpwg.org/specs/rfc7231.html#status.500"
                },
                "schema": {
                  "$ref": "#/components/schemas/Exception"
                }
              }
            },
            "description": "A server error occurred."
          }
        },
        "summary": "API definition",
        "tags": [
          "Capabilities"
        ]
      }
    },
    "/collections": {
      "get": {
        "operationId": "collections",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collections"
                }
              }
            },
            "description": "The feature collections shared by this API. \n\nThe dataset is organized as one or more feature collections. This resource provides information about and access to the collections. \n\nThe response contains the list of collections. For each collection, a link to the items in the collection (path `/collections/{collectionId}/items`, link relation `items`) as well as key information about the collection. This information includes: \n* A local identifier for the collection that is unique for the dataset; \n* A list of coordinate reference systems (CRS) in which geometries may be returned by the server. The first CRS is the default coordinate reference system (the default is always WGS 84 with axis order longitude/latitude); \n* An optional title and description for the collection; \n* An optional extent that can be used to provide an indication of the spatial and temporal extent of the collection - typically derived from the data; \n* An optional indicator about the type of the items in the collection (the default value, if the indicator is not provided, is 'feature')."
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "status": 400,
                  "type": "https://httpwg.org/specs/rfc7231.html#status.400"
                },
                "schema": {
                  "$ref": "#/components/schemas/Exception"
                }
              }
            },
            "description": "General HTTP error response."
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "type": "https://httpwg.org/specs/rfc7231.html#status.500"
                },
                "schema": {
                  "$ref": "#/components/schemas/Exception"
                }
              }
            },
            "description": "A server error occurred."
          }
        },
        "summary": "The feature collections in the dataset.",
        "tags": [
          "Capabilities"
        ]
      },
      "post": {
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Collection"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created.",
            "headers": {
              "Location": {
                "description": "URI of the newly added resource.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "status": 409,
                  "type": "https://httpwg.org/specs/rfc7231.html#status.409"
                },
                "schema": {
                  "$ref": "#/components/schemas/Exception"
                }
              }
            },
            "description": "Already exists."
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "type": "https://httpwg.org/specs/rfc7231.html#status.500"
                },
                "schema": {
                  "$ref": "#/components/schemas/Exception"
                }
              }
            },
            "description": "A server error occurred."
          }
        },
        "summary": "Create new collection metadata",
        "tags": [
          "Collections"
        ]
      }
    },
    "/collections/{collectionId}": {
      "delete": {
        "operationId": "remove",
        "parameters": [
          {
            "description": "local identifier of a collection",
            "in": "path",
            "name": "collectionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
