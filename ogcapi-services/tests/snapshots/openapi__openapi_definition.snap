    "/collections/{collectionId}/tiles/{tileMatrixSetId}/{tileMatrix}/{tileRow}/{tileCol}": {
      "get": {
        "operationId": "collection_tile",
        "parameters": [
          {
            "description": "Identifier selecting one of the [`TileMatrixSetId`] supported by the resource.",
            "in": "path",
            "name": "tileMatrixSetId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TileMatrixSetId"
            }
          },
          {
            "description": "Identifier selecting one of the scales defined in the [`TileMatrixSet`]\nand representing the scaleDenominator the tile.",
            "in": "path",
            "name": "tileMatrix",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Row index of the tile on the selected [`TileMatrix`]. It cannot exceed\nthe MatrixWidth-1 for the selected [`TileMatrix`].",
            "in": "path",
            "name": "tileRow",
            "required": true,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Column index of the tile on the selected [`TileMatrix`]. It cannot exceed\nthe MatrixHeight-1 for the selected [`TileMatrix`].",
            "in": "path",
            "name": "tileCol",
            "required": true,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The collections that should be included in the response. The parameter\nvalue is a comma-separated list of collection identifiers. If the\nparameters is missing, some or all collections will be included. The\ncollection will be rendered in the order specified, with the last one\nshowing on top, unless the priority is overridden by styling rules.",
            "explode": false,
            "in": "query",
            "name": "collections",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "items": {
                    "format": "int32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": "array"
                }
              }
            },
            "description": "A vector tile returned as a response."
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "type": "https://httpwg.org/specs/rfc7231.html#status.500"
                },
                "schema": {
                  "$ref": "#/components/schemas/Exception"
                }
              }
            },
            "description": "A server error occurred."
          }
        },
        "summary": "Retrieve a vector tile from a collection.",
        "tags": [
          "Vector Tiles"
        ]
      }
    },
    "/collections/{collectionId}/{queryType}": {
